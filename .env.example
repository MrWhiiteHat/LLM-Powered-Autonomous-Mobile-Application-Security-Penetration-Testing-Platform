# ==============================================================================
# Mobile Security Agent (MSA v2.0) - Environment Configuration
# ==============================================================================

# --- Server & Network Configuration ---
# Host interface to bind to (0.0.0.0 listens on all interfaces)
MSA_HOST=0.0.0.0
# Port to expose FastAPI backend & web dashboard
MSA_PORT=8000
# Enable FastAPI debug mode & detailed stack traces (true / false)
MSA_DEBUG=false

# --- LLM Provider & Reasoning Engine ---
# Primary inference backend: 'ollama', 'lmstudio', 'openai', 'nvidia', 'gemini', 'none'
LLM_PROVIDER=ollama
# Model tag (default: qwen2.5-coder:1.5b for fast local air-gapped CPU/GPU inference)
LLM_MODEL=qwen2.5-coder:1.5b
# API key for commercial / cloud endpoints (leave empty when using Ollama / local)
LLM_API_KEY=
# Custom API endpoint URL override (e.g., http://localhost:11434 for Ollama)
LLM_API_URL=http://localhost:11434
# Force CPU inference even if GPU / CUDA hardware is detected (true / false)
LLM_FORCE_CPU=false
# Maximum number of high-priority findings audited by LLM per scan session
LLM_MAX_AUDITS_PER_SCAN=5

# --- Decompiler & Dynamic Tooling Paths (Optional Overrides) ---
# Path to Android SDK platform-tools (auto-detected if unset)
# ANDROID_HOME=C:\Users\username\AppData\Local\Android\Sdk
# Path to JADX decompiler installation directory (auto-detected if unset)
# JADX_HOME=C:\Tools\jadx
